generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Eén voetbalkaart in de inventaris.
/// Alle bedragen staan in hele eurocenten (integer) — nooit floats voor geld.
model Card {
  id           String   @id @default(cuid())
  player       String
  year         String
  set          String
  variant      String?
  serialNumber String?
  isRookie     Boolean  @default(false)
  condition    String   @default("NM")
  priceLow     Int?
  priceHigh    Int?
  askingPrice  Int?
  status       String   @default("DRAFT")
  listingUrl   String?
  notes        String?
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([player])
  @@index([updatedAt])
}
